# =============================================================================
# CloudForge AI - environment configuration
# Copy to .env and fill in values:  cp .env.example .env
# NEVER commit a real .env file. All values below are placeholders.
# =============================================================================

APP_ENV=development
APP_NAME=CloudForge AI

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Internal backend origin used by the frontend /api rewrite proxy
# (production same-origin setup). Defaults to http://localhost:8000.
BACKEND_INTERNAL_URL=http://localhost:8000

# PostgreSQL connection used by the backend (docker-compose service name "db").
# Format for local non-docker dev: postgresql+psycopg://cloudforge:cloudforge@localhost:5432/cloudforge
DATABASE_URL=postgresql+psycopg://cloudforge:cloudforge@db:5432/cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=cloudforge
POSTGRES_DB=cloudforge

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI provider: "demo" (no key needed, deterministic output), "azure_openai", or "openai"
AI_PROVIDER=demo

# Required only when AI_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Required only when AI_PROVIDER=openai (https://platform.openai.com API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seed a demo organization + demo user (demo@cloudforge.local / DemoPass123!).
# Enabled automatically in docker-compose.demo.yml. Keep false in production.
SEED_DEMO=false

# Set to true in production so the auth cookie is Secure (requires HTTPS)
COOKIE_SECURE=false

LOG_LEVEL=INFO
